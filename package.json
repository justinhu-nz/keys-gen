{
  "name": "lower-third-studio",
  "version": "1.0.0",
  "description": "Portable lower-third video studio with native FFmpeg broadcast export",
  "main": "electron/main.cjs",
  "author": "Lower Third Studio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dir",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win:arm64": "electron-builder --win portable --arm64"
  },
  "build": {
    "appId": "nz.co.lowerthirdstudio.app",
    "productName": "Lower Third Studio",
    "asar": true,
    "compression": "store",
    "files": [
      "index.html",
      "electron/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin/${os}/${arch}",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.video"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
